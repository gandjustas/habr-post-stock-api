{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "Producer": {
      "BootstrapServers": "localhost:9092",
      "Acks": "All",
      "AllowAutoCreateTopics":true,
      "LingerMs": 5,
      "CompressionType": "Lz4"      
    },
    "Consumer": {
      "BootstrapServers": "localhost:9092",
      "AllowAutoCreateTopics":true
    }

  }, 
  "AllowedHosts": "*"
}
